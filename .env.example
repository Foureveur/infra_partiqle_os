# services/infra.env — secrets du service et du collecteur.
#
#   install -m 0600 .env.example /opt/studio-os/services/infra.env
#
# Aucun de ces jetons ne descend dans la page : le navigateur n'appelle jamais
# d'API tierce, il ne parle qu'à /api/state et /api/layout (§2).

# ---------------------------------------------------------------- ingestion
# Un jeton par machine. Le jeton de l'une ne peut pas écrire l'état d'une autre.
#   openssl rand -hex 32
INFRA_PUSH_TOKEN_VPS_CORE=
INFRA_PUSH_TOKEN_VPS_SAAS_01=
INFRA_PUSH_TOKEN_VPS_CLIENTS_01=
INFRA_PUSH_TOKEN_VPS_LAB=

# --------------------------------------------------------------------- Kuma
# Deux voies, complémentaires (§3.7).
#
# 1. Page de statut — donne la liste des moniteurs et l'uptime 24 h / 30 j.
#    Aucune page n'existe au 31/08 (`/api/entry-page` renvoie entryPage: null) :
#    en créer une dans l'UI Kuma, contenant TOUS les moniteurs, et mettre son
#    slug ici. Sans elle, un moniteur en pause est indétectable et la carte
#    l'annonce au lieu de faire semblant.
KUMA_STATUS_URL=http://uptime-kuma:3001
KUMA_STATUS_SLUG=
#
# 2. Endpoint Prometheus — état courant et temps de réponse. Vérifié le 31/08 :
#    /metrics répond 401, il existe et attend la clé API (Kuma → Profil → Clés
#    d'API). Authentification Basic, mot de passe = la clé, utilisateur vide.
KUMA_API_KEY=

# ---------------------------------------------------------------- GlitchTip
# Jeton d'authentification créé dans l'UI GlitchTip (Profil → Auth Tokens),
# portée `org:read` / `event:read`.
GLITCHTIP_URL=http://glitchtip-web:8000
GLITCHTIP_ORG=
GLITCHTIP_TOKEN=

# ----------------------------------------------------------------- Roadmaps
# Endpoint à construire côté Roadmaps — contrat dans
# docs/roadmaps-infra-summary.md. Tant qu'il n'existe pas, les cartes Projets
# et Échéances restent grises : c'est le comportement voulu.
ROADMAPS_SUMMARY_URL=https://roadmaps.partiqle.studio/api/infra/summary
ROADMAPS_TOKEN=

# ---------------------------------------------------------------- Hostinger
# Jeton d'API hPanel. Cadence 30 min, quota oblige.
HOSTINGER_URL=https://developers.hostinger.com
HOSTINGER_TOKEN=

# ------------------------------------------------------------------- seuils
# Décommenter pour ajuster. Les valeurs ci-dessous sont celles par défaut.
#
# MACHINE_STALE_SECONDS=900     # machine muette au-delà ⇒ INCONNUE (§3.2bis.5)
# STATE_STALE_SECONDS=900       # au-delà ⇒ bandeau « données figées »
# BACKUP_WARN_SECONDS=93600     # 26 h ⇒ orange
# BACKUP_CRIT_SECONDS=180000    # 50 h ⇒ rouge
# MIN_LAYOUT_VIEWPORT=768       # sous ce seuil, l'écriture de layout est refusée
#
# Budgets de fraîcheur par source (trois fois la cadence) :
# BUDGET_MACHINES=900
# BUDGET_KUMA=900
# BUDGET_GLITCHTIP=900
# BUDGET_BACKUPS=900
# BUDGET_ROADMAPS=2700
# BUDGET_HOSTINGER=5400

# ------------------------------------------------------------ développement
# UNIQUEMENT en local : contourne Authelia en fixant l'utilisateur. Laisser
# vide en production, sinon n'importe qui obtient la disposition de quelqu'un.
# INFRA_DEV_USER=quentin
