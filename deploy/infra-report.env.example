# /etc/infra-report.env — un fichier par machine, mode 0600, propriétaire root.
#
#   install -m 0600 -o root -g root infra-report.env.example /etc/infra-report.env
#
# Le jeton est DISTINCT par machine : celui de vps-lab ne peut pas écrire
# l'état de vps-core. Générer chacun avec :
#   openssl rand -hex 32

# Obligatoire. L'une des quatre valeurs, à l'identique de data/machines.json.
INFRA_MACHINE=vps-lab

# --- Machines distantes (saas-01, clients-01, lab) --------------------------
INFRA_INGEST_URL=https://infra.partiqle.studio
INFRA_PUSH_TOKEN=remplacer-par-le-jeton-de-cette-machine

# --- vps-core uniquement ----------------------------------------------------
# Core écrit en local, sans passer par le réseau ni par un jeton (§3.2bis.6).
# Décommenter les deux lignes ci-dessous, et laisser INFRA_INGEST_URL et
# INFRA_PUSH_TOKEN vides ou absents : INFRA_INGEST_FILE a la priorité.
#
# INFRA_MACHINE=vps-core
# INFRA_INGEST_FILE=/opt/studio-os/data/infra/machines/vps-core.json

# --- Facultatif -------------------------------------------------------------
# Évite un appel sortant vers api.ipify.org à chaque cycle si l'IP est fixe.
# INFRA_PUBLIC_IP=76.13.53.158
